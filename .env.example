# 合同审批审查系统 · 环境变量示例
# 复制本文件为 .env（或直接在部署平台注入同名变量），按真实环境填写。
# 优先级：环境变量 > 界面保存值(data/settings.json) > 内置默认。
# 注意：界面「合规规则与模板」页也可在线填写钉钉/审批对接参数，落盘后重启不丢。

# ----------------------------------------------------------------------------
# 服务网络
# ----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=18090

# ----------------------------------------------------------------------------
# 智能审查（大模型）
#   provider=mock：离线启发式，无需任何密钥，默认即可跑通全流程演示；
#   provider=openai：直连 OpenAI 兼容 /chat/completions 接口
#     （DeepSeek / 通义 / 本地 vLLM / Azure 等只要兼容该协议都能用）。
#   未配置 LLM_API_KEY / LLM_BASE_URL 时，即使 provider=openai 也会自动降级回 mock，
#   审查不会因 LLM 未就绪而整体失败。
# ----------------------------------------------------------------------------
LLM_PROVIDER=mock
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------------------
# 审批系统评论区回写（真实接口）
#   不填 APPROVAL_API_BASE 则走内存模拟回写（生成意见并落库，但不真正发往审批系统）。
#   填入地址即自动切真实回写。
# ----------------------------------------------------------------------------
# APPROVAL_API_BASE=https://approval.your-company.com
# APPROVAL_API_TOKEN=xxxxxxxxxxxxxxxx
# APPROVAL_AUTH_SCHEME=bearer          # bearer | token-header | none
# APPROVAL_AUTH_HEADER=X-Approval-Token  # scheme=token-header 时自定义请求头名
# APPROVAL_COMMENT_PATH=api/approval/comment
# APPROVAL_INSTANCE_FIELD=instance_id  # 回写请求体里标记审批单/实例的字段名
# APPROVAL_TIMEOUT=10
# APPROVAL_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# 失败任务外发（钉钉群机器人）
#   不填 DINGTALK_WEBHOOK 则走模拟推送（流程/留痕/审核全可跑通，但群内收不到）。
# ----------------------------------------------------------------------------
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# DINGTALK_SECRET=SECxxxxxxxxxxxxxxxx
# DINGTALK_KEYWORD=合同审查
# DINGTALK_AT_MOBILES=13800000000,13900000000
